        let cond;
        if (this.conditionType === 'time') {
            cond = { type: 'time', time: this.conditionTime };
        }
        else {
            cond = { type: 'manual' };
        }
        const conditions = [cond];
        let actions = [];
        if (this.selectedDevice !== null) {
            const act = { did: this.selectedDevice.did, method: 'set_power', params: [this.targetPower] };
            actions = [act];
        }
        const sceneId = this.editingSceneId === '' ? `scene_${Date.now()}` : this.editingSceneId;
        const scene = {
            sceneId: sceneId,
            name: this.sceneName,
            enabled: true,
            conditions: conditions,
            actions: actions
        };
        await ApiService.saveScene(scene);
        promptAction.showToast({ message: 'åœºæ™¯å·²ä¿å­˜' });
        router.back();
    }
