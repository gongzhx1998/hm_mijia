import * as ApiService from '../service/ApiService';
import { Device } from '../model/Models';

/**
 * å…¨éƒ¨è®¾å¤‡é¡µï¼šæŒ‰æˆ¿é—´åˆ†ç»„å±•ç¤ºæ‰€æœ‰çœŸå®è®¾å¤‡
 */
@Entry
@Component
struct DeviceList {
  @State devices: Device[] = [];
  @State rooms: string[] = [];
  @State roomMap: Record<string, string[]> = {};

  async aboutToAppear(): Promise<void> {
    this.devices = await ApiService.getDevices('');
    this.buildGroup();
  }

  /** æ„å»º roomId â†’ è®¾å¤‡ did æ•°ç»„ çš„æ˜ å°„ï¼Œä»¥åŠæˆ¿é—´é¡ºåº */
  buildGroup(): void {
    const map: Record<string, string[]> = {};
    const order: string[] = [];
    for (let i = 0; i < this.devices.length; i++) {
      const d = this.devices[i];
      const key = d.roomId === '' ? '__none__' : d.roomId;
      if (map[key] === undefined) {
        map[key] = [];
        order.push(key);
      }
      map[key].push(d.did);
    }
    this.roomMap = map;
    this.rooms = order;
  }

  devicesInRoom(roomKey: string): Device[] {
    const dids = this.roomMap[roomKey];
    const result: Device[] = [];
    if (dids === undefined) {
      return result;
    }
    for (let i = 0; i < this.devices.length; i++) {
      for (let j = 0; j < dids.length; j++) {
        if (this.devices[i].did === dids[j]) {
          result.push(this.devices[i]);
          break;
        }
      }
    }
    return result;
  }

  roomName(roomKey: string): string {
    if (roomKey === '__none__') {
      return 'æœªåˆ†ç»„è®¾å¤‡';
    }
    return `æˆ¿é—´ ${roomKey}`;
  }

  deviceIcon(type: string): string {
    if (type === 'light') {
      return 'ğŸ’¡';
    }
    if (type === 'switch') {
      return 'ğŸ”Œ';
    }
    if (type === 'sensor') {
      return 'ğŸ“¡';
    }
    if (type === 'camera') {
      return 'ğŸ“·';
    }
    return 'ğŸ“¦';
  }

  @Builder
  DeviceRow(device: Device) {
    Row() {
      Text(this.deviceIcon(device.type)).fontSize(24)
      Column() {
        Text(device.name)
          .fontSize(15)
          .fontColor('#1A1A1A')
        Text(device.online ? 'åœ¨çº¿' : 'ç¦»çº¿')
          .fontSize(12)
          .fontColor(device.online ? '#52C41A' : '#BFBFBF')
          .margin({ top: 3 })
      }
      .alignItems(HorizontalAlign.Start)
      .margin({ left: 12 })
      .layoutWeight(1)
      Text('>').fontSize(16).fontColor('#BBBBBB')
    }
    .width('100%')
    .padding(14)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .margin({ bottom: 8 })
    .onClick(() => {
      router.pushUrl({ url: 'pages/DeviceControl', params: { did: device.did } });
    })
  }

  @Builder
  RoomGroup(roomKey: string) {
    Column() {
      Row() {
        Text(this.roomName(roomKey))
          .fontSize(14)
          .fontWeight(FontWeight.Medium)
          .fontColor('#666666')
        Blank()
        Text(`${this.devicesInRoom(roomKey).length} ä¸ªè®¾å¤‡`)
          .fontSize(12)
          .fontColor('#999999')
      }
      .width('100%')
      .margin({ top: 8, bottom: 10 })

      ForEach(this.devicesInRoom(roomKey), (device: Device) => {
        this.DeviceRow(device)
      })
    }
    .width('100%')
  }

  build() {
    Column() {
      Row() {
        Text('â†')
          .fontSize(20)
          .onClick(() => { router.back(); })
        Text('å…¨éƒ¨è®¾å¤‡')
          .fontSize(18)
          .fontWeight(FontWeight.Medium)
          .margin({ left: 12 })
        Blank()
        Text('ï¼‹ æ·»åŠ ')
          .fontSize(14)
          .fontColor('#1677FF')
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 14, bottom: 12 })

      Scroll() {
        Column() {
          ForEach(this.rooms, (roomKey: string) => {
            this.RoomGroup(roomKey)
          })
        }
        .padding({ left: 16, right: 16, bottom: 20 })
      }
      .layoutWeight(1)
      .scrollBar(BarState.Off)
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F5F6F7')
  }
}
