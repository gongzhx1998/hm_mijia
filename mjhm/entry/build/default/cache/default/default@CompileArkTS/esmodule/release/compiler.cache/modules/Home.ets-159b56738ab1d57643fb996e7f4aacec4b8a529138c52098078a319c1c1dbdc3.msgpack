const TAG = 'Home';

/**
 * ä¸»ç•Œé¢ï¼ˆå¯¹æ ‡åŸç‰ˆç±³å®¶ SmartHomeMainActivityï¼Œ2 Tabï¼šç±³å®¶/æˆ‘çš„ï¼‰ï¼š
 * - é¦–é¡µï¼šå®¶åº­åâŒ„ + æˆ¿é—´Tabï¼ˆå…¨å±‹/å„æˆ¿é—´ + â‰¡å¼¹å±‚ï¼‰+ 2åˆ—æ·±è‰²è®¾å¤‡å¡ + ç¼–è¾‘æŒ‰é’®
 * - æˆ‘çš„ï¼šä¸ªäººä¸­å¿ƒï¼ˆProfileTabï¼‰
 * åœ°åŒºå›ºå®šä¸­å›½å¤§é™†ï¼ˆapi.mijia.techï¼‰ï¼Œæ— éšç§/æœåŠ¡å™¨é€‰æ‹©é¡µã€‚å…¨çœŸå®æ•°æ®ï¼Œæ—  mockã€‚
 */
@Entry
@Component
struct HomePage {
  @State currentTab: number = 0;
  @State homeName: string = 'æˆ‘çš„å®¶';
  @State homeId: string = '';
  @State homes: Home[] = [];
  @State rooms: Room[] = [];
  @State devices: Device[] = [];
  @State currentRoom: string = '';
  @State loading: boolean = true;
  @State errorMsg: string = '';
  @State showRoomSheet: boolean = false;
  @State showHomeSheet: boolean = false;

  async aboutToAppear(): Promise<void> {
    const token = await Storage.getString(AppConfig.KEY_TOKEN, '');
    if (token === '') {
      router.replaceUrl({ url: 'pages/Login' });
      return;
    }
    // æ¢å¤ç±³å®¶äº‘ç™»å½•æ€ï¼ˆssecurity/serviceToken/userIdï¼‰ï¼Œå¦åˆ™äº‘ç­¾åè¯·æ±‚ä¼šå›  ssecurity ä¸ºç©ºè€Œå¤±è´¥
    await MiCloud.restoreSession();
    await this.loadData();
  }

  async loadData(): Promise<void> {
    this.loading = true;
    this.errorMsg = '';
    try {
      this.homes = await ApiService.getHomes();
      if (this.homes.length > 0) {
        this.homeName = this.homes[0].name;
        this.homeId = this.homes[0].homeId;
        this.rooms = await ApiService.getRooms(this.homeId);
      }
      this.devices = await ApiService.getDevices(this.homeId);
      // æ‰¹é‡è¯»å–å¯å¼€å…³è®¾å¤‡çš„ç”µæºçŠ¶æ€ï¼Œè®©å¼€å…³æŒ‰é’®æ˜¾ç¤ºçœŸå®çŠ¶æ€
      await ApiService.readPowerStates(this.devices);
      Logger.info(TAG, `loadData done: homes=${this.homes.length} rooms=${this.rooms.length} devices=${this.devices.length}`);
    } catch (e) {
      Logger.error(TAG, `loadData failed: ${e}`);
      this.errorMsg = 'åŒæ­¥å¤±è´¥ï¼Œè¯·æ£€æŸ¥ç½‘ç»œåä¸‹æ‹‰é‡è¯•';
    } finally {
      this.loading = false;
    }
  }

  /** åˆ‡æ¢å®¶åº­ï¼šæ›´æ–° homeId/homeNameï¼Œé‡æ–°æ‹‰å–è¯¥å®¶åº­çš„æˆ¿é—´å’Œè®¾å¤‡ */
  async switchHome(home: Home): Promise<void> {
    this.showHomeSheet = false;
    if (home.homeId === this.homeId) {
      return;
    }
    this.homeId = home.homeId;
    this.homeName = home.name;
    this.currentRoom = '';
    this.loading = true;
    this.errorMsg = '';
    try {
      this.rooms = await ApiService.getRooms(home.homeId);
      this.devices = await ApiService.reloadDevicesForHome(home.homeId);
      await ApiService.readPowerStates(this.devices);
      Logger.info(TAG, `switchHome done: ${home.name} rooms=${this.rooms.length} devices=${this.devices.length}`);
    } catch (e) {
      Logger.error(TAG, `switchHome failed: ${e}`);
      this.errorMsg = 'åˆ‡æ¢å®¶åº­å¤±è´¥ï¼Œè¯·é‡è¯•';
    } finally {
      this.loading = false;
    }
  }

  /** æˆ¿é—´ Tab åˆ—è¡¨ï¼šå…¨å±‹ + å„æˆ¿é—´ */
  roomTabs(): Room[] {
    return this.rooms;
  }

  filteredDevices(): Device[] {
    if (this.currentRoom === '') {
      return this.devices;
    }
    const result: Device[] = [];
    for (let i = 0; i < this.devices.length; i++) {
      if (this.devices[i].roomId === this.currentRoom) {
        result.push(this.devices[i]);
      }
    }
    return result;
  }

  roomName(roomId: string): string {
    for (let i = 0; i < this.rooms.length; i++) {
      if (this.rooms[i].roomId === roomId) {
        return this.rooms[i].name;
      }
    }
    return '';
  }

  roomDeviceCount(roomId: string): number {
    let n = 0;
    for (let i = 0; i < this.devices.length; i++) {
      if (this.devices[i].roomId === roomId) {
        n++;
      }
    }
    return n;
  }

  isSwitchable(device: Device): boolean {
    return device.type === 'switch' || device.type === 'light' || device.type === 'air_conditioner'
      || device.type === 'air_purifier' || device.type === 'humidifier' || device.type === 'fan'
      || device.type === 'heater' || device.type === 'desk';
  }

  devicePower(device: Device): boolean {
    return device.props['power'] === true;
  }

  deviceIcon(type: string): string {
    if (type === 'light') {
      return 'ğŸ’¡';
    }
    if (type === 'switch') {
      return 'ğŸ”Œ';
    }
    if (type === 'sensor') {
      return 'ğŸŒ¡ï¸';
    }
    if (type === 'camera') {
      return 'ğŸ“·';
    }
    if (type === 'air_conditioner') {
      return 'â„ï¸';
    }
    if (type === 'air_purifier') {
      return 'ğŸƒ';
    }
    if (type === 'water_purifier') {
      return 'ğŸš°';
    }
    if (type === 'humidifier') {
      return 'ğŸ’§';
    }
    if (type === 'desk') {
      return 'ğŸª‘';
    }
    if (type === 'fan') {
      return 'ğŸŒ€';
    }
    if (type === 'heater') {
      return 'ğŸ”¥';
    }
    if (type === 'curtain') {
      return 'ğŸªŸ';
    }
    if (type === 'lock') {
      return 'ğŸ”’';
    }
    if (type === 'washer') {
      return 'ğŸ§º';
    }
    if (type === 'speaker') {
      return 'ğŸ”Š';
    }
    if (type === 'juicer') {
      return 'ğŸ¥¤';
    }
    if (type === 'cooker') {
      return 'ğŸ³';
    }
    if (type === 'fridge') {
      return 'ğŸ§Š';
    }
    if (type === 'router') {
      return 'ğŸ“¶';
    }
    return 'ğŸ“±';
  }

  async toggleDevice(device: Device, isOn: boolean): Promise<void> {
    const cmd: DeviceCommand = { did: device.did, method: 'set_power', params: [isOn ? 'on' : 'off'] };
    try {
      await ApiService.controlDevice(cmd);
      device.props['power'] = isOn;
      // è§¦å‘åˆ·æ–°ï¼ˆArkTS æ— å±•å¼€è¯­æ³•ï¼Œæ‰‹åŠ¨é‡å»ºæ•°ç»„ï¼‰
      const next: Device[] = [];
      for (let i = 0; i < this.devices.length; i++) {
        next.push(this.devices[i]);
      }
      this.devices = next;
      Logger.info(TAG, `toggle ok: ${device.name} -> ${isOn}`);
    } catch (e) {
      Logger.error(TAG, `toggle failed: ${e}`);
    }
  }

  build() {
    Tabs({ barPosition: BarPosition.End, index: this.currentTab }) {
      // ===== Tab 1ï¼šç±³å®¶é¦–é¡µ =====
      TabContent() {
        this.HomeContent()
      }
      .tabBar(this.TabBarItem('ç±³å®¶', 'âŒ‚', 0))

      // ===== Tab 2ï¼šæˆ‘çš„ =====
      TabContent() {
        ProfileTab({
          onLoggedOut: () => {
            router.replaceUrl({ url: 'pages/Login' });
          }
        })
      }
      .tabBar(this.TabBarItem('æˆ‘çš„', 'â˜º', 1))
    }
    .barHeight(56)
    .onChange((index: number) => {
      this.currentTab = index;
    })
    .width('100%')
    .height('100%')
  }

  // ==================== é¦–é¡µå†…å®¹ ====================
  @Builder
  HomeContent() {
    Stack() {
      // å¤©ç©ºè“æ¸å˜èƒŒæ™¯ï¼ˆåŸç‰ˆç±³å®¶é¦–é¡µé£æ ¼ï¼‰
      Column()
        .width('100%')
        .height('100%')
        .linearGradient({
          angle: 180,
          colors: [['#6E93B8', 0], ['#87A9C9', 0.35], ['#A7C2D8', 0.7], ['#C3D6E5', 1]]
        })

      Column() {
        // é¡¶éƒ¨å›¾æ ‡æ ï¼šå®¶åº­åâŒ„ + æ¶ˆæ¯ + æ·»åŠ 
        Row() {
          Blank()
          Text('ğŸ””')
            .fontSize(22)
            .fontColor('#FFFFFF')
            .margin({ right: 22 })
            .onClick(() => {
              // æ¶ˆæ¯ä¸­å¿ƒï¼ˆåŸç‰ˆä¸ºæœåŠ¡ç«¯æ¨é€æ¶ˆæ¯ï¼Œæ­¤å¤„ç•™å…¥å£ï¼‰
            })
          Text('ï¼‹')
            .fontSize(26)
            .fontWeight(FontWeight.Medium)
            .fontColor('#FFFFFF')
            .onClick(() => {
              this.showRoomSheet = true;
            })
        }
        .width('100%')
        .padding({ left: 20, right: 20, top: 12, bottom: 6 })

        // æ ‡é¢˜ï¼šå®¶åº­åâŒ„ï¼ˆç‚¹å‡»å¼¹å‡ºå®¶åº­åˆ‡æ¢ï¼‰
        Row() {
          Text(this.homeName)
            .fontSize(26)
            .fontWeight(FontWeight.Bold)
            .fontColor('#FFFFFF')
          Text('âŒ„')
            .fontSize(18)
            .fontColor('#FFFFFF')
            .margin({ left: 4 })
        }
        .width('100%')
        .padding({ left: 20, right: 20, top: 6, bottom: 10 })
        .onClick(() => {
          if (this.homes.length > 1) {
            this.showHomeSheet = true;
          }
        })

        // æˆ¿é—´ Tab è¡Œï¼ˆå…¨å±‹ + å„æˆ¿é—´ + â‰¡ï¼‰
        Row() {
          Scroll() {
            Row() {
              this.RoomTabItem('å…¨å±‹', '', 0)
              ForEach(this.roomTabs(), (room: Room) => {
                this.RoomTabItem(room.name, room.roomId, this.roomDeviceCount(room.roomId))
              })
            }
          }
          .scrollable(ScrollDirection.Horizontal)
          .scrollBar(BarState.Off)
          .layoutWeight(1)

          Text('â‰¡')
            .fontSize(20)
            .fontColor('#FFFFFF')
            .margin({ left: 10 })
            .onClick(() => {
              this.showRoomSheet = true;
            })
        }
        .width('100%')
        .padding({ left: 20, right: 16 })
        .margin({ bottom: 14 })

        // å†…å®¹åŒº
        if (this.loading) {
          Column() {
            LoadingProgress()
              .width(40)
              .height(40)
              .color('#FFFFFF')
            Text('æ­£åœ¨åŒæ­¥è®¾å¤‡â€¦')
              .fontSize(13)
              .fontColor('#E8F0F8')
              .margin({ top: 12 })
          }
          .width('100%')
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
        } else if (this.errorMsg !== '') {
          Column() {
            Text(this.errorMsg)
              .fontSize(14)
              .fontColor('#F5F5F5')
              .textAlign(TextAlign.Center)
            Text('é‡è¯•')
              .fontSize(14)
              .fontColor('#FFFFFF')
              .padding({ left: 24, right: 24, top: 8, bottom: 8 })
              .backgroundColor('#33FFFFFF')
              .borderRadius(20)
              .margin({ top: 16 })
              .onClick(() => {
                this.loadData();
              })
          }
          .width('100%')
          .layoutWeight(1)
          .justifyContent(FlexAlign.Center)
        } else {
          Grid() {
            ForEach(this.filteredDevices(), (device: Device) => {
              GridItem() {
                this.DeviceCard(device)
              }
            })
          }
          .columnsTemplate('1fr 1fr')
          .columnsGap(12)
          .rowsGap(12)
          .padding({ left: 16, right: 16 })
          .layoutWeight(1)
          .scrollBar(BarState.Off)
        }

        // ç¼–è¾‘æŒ‰é’®
        if (!this.loading && this.filteredDevices().length > 0) {
          Text('ç¼–è¾‘')
            .fontSize(14)
            .fontColor('#FFFFFF')
            .padding({ left: 26, right: 26, top: 9, bottom: 9 })
            .backgroundColor('#4D3D4F5E')
            .borderRadius(20)
            .margin({ top: 8, bottom: 12 })
        }
      }
      .width('100%')
      .height('100%')

      // â‰¡ æˆ¿é—´åˆ—è¡¨å¼¹å±‚ï¼ˆåŸç‰ˆ 38_æˆ¿é—´åˆ—è¡¨å¼¹å±‚ï¼‰
      if (this.showRoomSheet) {
        Column()
          .width('100%')
          .height('100%')
          .backgroundColor('#66000000')
          .onClick(() => {
            this.showRoomSheet = false;
          })
        Column() {
          Text('å…¨éƒ¨è®¾å¤‡')
            .fontSize(17)
            .fontWeight(FontWeight.Medium)
            .fontColor('#FFFFFF')
            .width('100%')
            .padding({ left: 20, top: 16, bottom: 14 })
            .onClick(() => {
              this.showRoomSheet = false;
              this.currentRoom = '';
            })
          Scroll() {
            Column() {
              this.SheetRoomItem('å…¨å±‹', '', this.devices.length)
              ForEach(this.roomTabs(), (room: Room) => {
                this.SheetRoomItem(room.name, room.roomId, this.roomDeviceCount(room.roomId))
              })
            }
          }
          .layoutWeight(1)
          .scrollBar(BarState.Off)
        }
        .width('62%')
        .height('70%')
        .backgroundColor('#E6222B33')
        .borderRadius(16)
        .margin({ top: 150 })
        .alignItems(HorizontalAlign.Start)
      }

      // å®¶åº­åˆ‡æ¢å¼¹å±‚ï¼ˆç‚¹å‡»æ ‡é¢˜ã€Œå®¶åº­åâŒ„ã€å¼¹å‡ºï¼‰
      if (this.showHomeSheet) {
        Column()
          .width('100%')
          .height('100%')
          .backgroundColor('#66000000')
          .onClick(() => {
            this.showHomeSheet = false;
          })
        Column() {
          Text('é€‰æ‹©å®¶åº­')
            .fontSize(17)
            .fontWeight(FontWeight.Medium)
            .fontColor('#FFFFFF')
            .width('100%')
            .padding({ left: 20, top: 16, bottom: 14 })
          Scroll() {
            Column() {
              ForEach(this.homes, (home: Home) => {
                this.HomeSheetItem(home)
              })
            }
          }
          .layoutWeight(1)
          .scrollBar(BarState.Off)
        }
        .width('62%')
        .height('70%')
        .backgroundColor('#E6222B33')
        .borderRadius(16)
        .margin({ top: 150 })
        .alignItems(HorizontalAlign.Start)
      }
    }
    .width('100%')
    .height('100%')
  }

  @Builder
  RoomTabItem(label: string, roomId: string, count: number) {
    Column() {
      Text(label)
        .fontSize(this.currentRoom === roomId ? 18 : 16)
        .fontWeight(this.currentRoom === roomId ? FontWeight.Bold : FontWeight.Normal)
        .fontColor(this.currentRoom === roomId ? '#FFFFFF' : '#D0DEEA')
      // é€‰ä¸­ä¸‹åˆ’çº¿
      Row()
        .width(20)
        .height(3)
        .borderRadius(2)
        .backgroundColor(this.currentRoom === roomId ? '#FFFFFF' : Color.Transparent)
        .margin({ top: 4 })
    }
    .margin({ right: 20 })
    .onClick(() => {
      this.currentRoom = roomId;
    })
  }

  @Builder
  SheetRoomItem(label: string, roomId: string, count: number) {
    Row() {
      Text(label)
        .fontSize(16)
        .fontColor('#FFFFFF')
        .layoutWeight(1)
      Text(String(count))
        .fontSize(15)
        .fontColor('#99FFFFFF')
    }
    .width('100%')
    .padding({ left: 20, right: 20, top: 13, bottom: 13 })
    .onClick(() => {
      this.currentRoom = roomId;
      this.showRoomSheet = false;
    })
  }

  @Builder
  HomeSheetItem(home: Home) {
    Row() {
      Text(home.name)
        .fontSize(16)
        .fontColor(this.homeId === home.homeId ? '#FFD54F' : '#FFFFFF')
        .layoutWeight(1)
      Text(`${home.deviceCount} ä¸ªè®¾å¤‡`)
        .fontSize(14)
        .fontColor('#99FFFFFF')
      if (this.homeId === home.homeId) {
        Text('âœ“')
          .fontSize(16)
          .fontColor('#FFD54F')
          .margin({ left: 10 })
      }
    }
    .width('100%')
    .padding({ left: 20, right: 20, top: 15, bottom: 15 })
    .onClick(() => {
      this.switchHome(home);
    })
  }

  // æ·±è‰²è®¾å¤‡å¡ï¼ˆåŸç‰ˆæ ·å¼ï¼šæ·±è‰²åœ†è§’å¡ + å›¾æ ‡å— + åç§° + æˆ¿é—´Â·çŠ¶æ€ï¼‰
  @Builder
  DeviceCard(device: Device) {
    Stack({ alignContent: Alignment.TopStart }) {
      Column() {
        // å›¾æ ‡å—
        Row() {
          Text(this.deviceIcon(device.type))
            .fontSize(30)
        }
        .width(56)
        .height(56)
        .borderRadius(12)
        .backgroundColor('#33FFFFFF')
        .justifyContent(FlexAlign.Center)

        Blank()

        Text(device.name)
          .fontSize(15)
          .fontWeight(FontWeight.Medium)
          .fontColor('#FFFFFF')
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
          .width('100%')
          .textAlign(TextAlign.Start)

        Text(device.online
          ? (this.roomName(device.roomId) === '' ? 'æœªåˆ†é…æˆ¿é—´' : this.roomName(device.roomId))
          : `${this.roomName(device.roomId) === '' ? '' : this.roomName(device.roomId) + ' Â· '}è®¾å¤‡ç¦»çº¿`)
          .fontSize(12)
          .fontColor(device.online ? '#B8CBD9' : '#7F93A5')
          .maxLines(1)
          .margin({ top: 3 })
          .width('100%')
          .textAlign(TextAlign.Start)
      }
      .alignItems(HorizontalAlign.Start)
      .width('100%')
      .height(150)
      .padding(14)

      // å¼€å…³ç±»è®¾å¤‡ï¼šå³ä¸Šè§’ç”µæºæŒ‰é’®ï¼ˆçœŸå®ä¸‹å‘ï¼‰
      if (this.isSwitchable(device) && device.online) {
        Row() {
          Text('â»')
            .fontSize(16)
            .fontColor(this.devicePower(device) ? '#FFD54F' : '#B8CBD9')
        }
        .width(34)
        .height(34)
        .borderRadius(17)
        .backgroundColor(this.devicePower(device) ? '#66FFD54F' : '#26FFFFFF')
        .justifyContent(FlexAlign.Center)
        .align(Alignment.TopEnd)
        .onClick(() => {
          this.toggleDevice(device, !this.devicePower(device));
        })
      }
    }
    .width('100%')
    .height(150)
    .backgroundColor('#D9222B33')
    .borderRadius(16)
    .onClick(() => {
      router.pushUrl({ url: 'pages/DeviceControl', params: { did: device.did } });
    })
  }

  @Builder
  TabBarItem(label: string, icon: string, index: number) {
    Column() {
      Text(icon)
        .fontSize(20)
        .fontColor(this.currentTab === index ? '#4A90D9' : '#999999')
      Text(label)
        .fontSize(11)
        .fontColor(this.currentTab === index ? '#4A90D9' : '#999999')
        .margin({ top: 2 })
    }
    .width('100%')
    .justifyContent(FlexAlign.Center)
