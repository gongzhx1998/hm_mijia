({ message: '场景执行失败' });\n        }\n    }\n    SceneRow(scene: Scene, parent = null) {\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Row.create();\n            Row.width('100%');\n            Row.padding(14);\n            Row.backgroundColor('#FFFFFF');\n            Row.borderRadius(12);\n            Row.margin({ bottom: 10 });\n            Row.onClick(() => {\n                router.pushUrl({ url: 'pages/SceneEdit', params: { sceneId: scene.sceneId } });\n            });\n        }, Row);\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Column.create();\n            Column.alignItems(HorizontalAlign.Start);\n            Column.layoutWeight(1);\n        }, Column);\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Text.create(scene.name);\n            Text.fontSize(15);\n            Text.fontColor('#1A1A1A');\n        }, Text);\n        Text.pop();\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Text.create(this.describeCondition(scene));\n            Text.fontSize(12);\n            Text.fontColor('#999999');\n            Text.margin({ top: 4 });\n        }, Text);\n        Text.pop();\n        Column.pop();\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Text.create('▶ 执行');\n            Text.fontSize(13);\n            Text.fontColor('#1677FF');\n            Text.padding({ left: 12, right: 12, top: 6, bottom: 6 });\n            Text.backgroundColor('#E8F3FF');\n            Text.borderRadius(14);\n            Text.margin({ right: 10 });\n            Text.onClick(() => { this.runScene(scene); });\n        }, Text);\n        Text.pop();\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Toggle.create({ type: ToggleType.Switch, isOn: scene.enabled });\n            Toggle.selectedColor('#1677FF');\n            Toggle.onChange((isOn: boolean) => {\n                scene.enabled = isOn;\n                ApiService.saveScene(scene);\n            });\n        }, Toggle);\n        Toggle.pop();\n        Row.pop();\n    }\n    describeCondition(scene: Scene): string {\n        if (scene.conditions.length === 0) {\n            return '无触发条件';\n        }\n        const c = scene.conditions[0];\n        if (c.type === 'manual') {\n            return '手动触发';\n        }\n        if (c.type === 'time') {\n            return `定时 ${c.time}`;\n        }\n        return '传感器触发';\n    }\n    initialRender() {\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Column.create();\n            Column.width('100%');\n            Column.height('100%');\n            Column.backgroundColor('#F5F6F7');\n        }, Column);\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Row.create();\n            Row.width('100%');\n            Row.padding({ left: 16, right: 16, top: 14, bottom: 12 });\n        }, Row);\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Text.create('←');\n            Text.fontSize(20);\n            Text.onClick(() => { router.back(); });\n        }, Text);\n        Text.pop();\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Text.create('场景');\n            Text.fontSize(18);\n            Text.fontWeight(FontWeight.Medium);\n            Text.margin({ left: 12 });\n        }, Text);\n        Text.pop();\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Blank.create();\n        }, Blank);\n        Blank.pop();\n        this.observeComponentCreation2((elmtId, isInitialRender) => {\n            Text.create('＋ 新建');\n            Text.fontSize(14);\n            Text.fontColor('#1677FF');\n            Text.onClick(() => {\n                router.pushUrl({ url: 'pages/SceneEdit', params: { sceneId: '' } });\n            });\n        }, Text);\n        Text.pop();\n        