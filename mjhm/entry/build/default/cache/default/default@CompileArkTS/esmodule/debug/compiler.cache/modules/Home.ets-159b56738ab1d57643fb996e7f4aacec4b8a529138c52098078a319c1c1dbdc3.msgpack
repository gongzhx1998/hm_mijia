const TAG = 'Home';

/**
 * ä¸»ç•Œé¢ï¼ˆå¯¹æ ‡åŸç‰ˆç±³å®¶ SmartHomeMainActivityï¼Œ2 Tabï¼šç±³å®¶/æˆ‘çš„ï¼‰ï¼š
 * - é¦–é¡µï¼šå®¶åº­åâŒ„ + æˆ¿é—´Tabï¼ˆå…¨å±‹/å„æˆ¿é—´ + â‰¡å¼¹å±‚ï¼‰+ 2åˆ—æ·±è‰²è®¾å¤‡å¡
