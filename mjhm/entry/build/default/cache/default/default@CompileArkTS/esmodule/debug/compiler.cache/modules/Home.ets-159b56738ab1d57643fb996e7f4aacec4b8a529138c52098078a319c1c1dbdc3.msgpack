          }
        })
      }
      .tabBar(this.TabBarItem('æˆ‘çš„', 1))
    }
    .barHeight(56)
    .onChange((index: number) => {
      this.currentTab = index;
      this.applyStatusBar();
    })
    .width('100%')
    .height('100%')
  }

  // ==================== é¦–é¡µå†…å®¹ ====================
  @Builder
  HomeContent() {
    Stack({ alignContent: Alignment.TopStart }) {
