    if (type === 'camera') {
      return 'ğŸ“·';
    }
    if (type === 'air_conditioner') {
      return 'â„ï¸';
    }
    if (type === 'air_purifier') {
      return 'ğŸƒ';
    }
    if (type === 'water_purifier') {
      return 'ğŸš°';
    }
    if (type === 'humidifier') {
      return 'ğŸ’§';
    }
    if (type === 'desk') {
      return 'ğŸª‘';
