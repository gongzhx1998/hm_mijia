      .width('100%')
      .height('100%')

      // â‰¡ æˆ¿é—´åˆ—è¡¨å¼¹å±‚ï¼ˆç±³å®¶åŸç‰ˆæ ·å¼ï¼šç™½è‰²åœ†è§’å¡é å³ï¼Œæˆ¿é—´+è®¾å¤‡æ•°ï¼Œåº•éƒ¨å¯¼èˆªç¼–è¾‘/å…¨éƒ¨è®¾å¤‡ï¼‰
      if (this.showRoomSheet) {
        Column()
          .width('100%')
          .height('100%')
          .backgroundColor('#33000000')
          .onClick(() => {
            this.showRoomSheet = false;
          })
        Row() {
          Blank()
          Column() {
            Scroll() {
              Column() {
                this.SheetRoomItem('å…¨å±‹', '', this.devices.length)
                ForEach(this.roomTabs(), (room: Room) => {
                  this.SheetRoomItem(room.name, room.roomId, this.roomDeviceCount(room.roomId))
                })
              }
            }
            .constraintSize({ maxHeight: 420 })
            .scrollBar(BarState.Off)

            Row()
              .width('100%')
              .height(0.5)
              .backgroundColor('#EEEEEE')

            Row() {
              Text('å¯¼èˆªç¼–è¾‘')
                .fontSize(17)
                .fontWeight(FontWeight.Bold)
                .fontColor('#1A1A1A')
                .layoutWeight(1)
              Text('âš™ï¸')
                .fontSize(20)
            }
            .width('100%')
            .padding({ left: 22, right: 22, top: 16, bottom: 16 })

            Row() {
              Text('å…¨éƒ¨è®¾å¤‡')
                .fontSize(17)
                .fontWeight(FontWeight.Bold)
                .fontColor('#1A1A1A')
                .layoutWeight(1)
              Text('ğŸ”')
                .fontSize(20)
            }
            .width('100%')
            .padding({ left: 22, right: 22, top: 4, bottom: 20 })
            .onClick(() => {
              this.showRoomSheet = false;
              this.currentRoom = '';
              router.pushUrl({ url: 'pages/DeviceList' });
            })
          }
          .width('58%')
          .backgroundColor('#FFFFFF')
          .borderRadius(24)
          .margin({ right: 16 })
          .alignItems(HorizontalAlign.Start)
        }
        .width('100%')
        .margin({ top: 128 })
      }

      // å®¶åº­åˆ‡æ¢å¼¹å±‚ï¼ˆç±³å®¶åŸç‰ˆæ ·å¼ï¼šç™½è‰²åœ†è§’å¡ï¼Œå®šä½é¡¹ + å®¶åº­åˆ—è¡¨ï¼ˆå½“å‰ç»¿âœ“ï¼‰ + å®¶åº­ç®¡ç†ï¼‰
      if (this.showHomeSheet) {
        Column()
          .width('100%')
          .height('100%')
          .backgroundColor('#33000000')
          .onClick(() => {
            this.showHomeSheet = false;
          })
        Row() {
          Column() {
            // é¡¶éƒ¨ï¼šå®šä½å›¾æ ‡ + å½“å‰å®¶åº­å
            Row() {
              Text('ğŸ“')
                .fontSize(20)
              Text(this.homeName)
                .fontSize(18)
                .fontWeight(FontWeight.Bold)
                .fontColor('#1A1A1A')
                .margin({ left: 12 })
                .layoutWeight(1)
            }
            .width('100%')
            .padding({ left: 20, right: 20, top: 20, bottom: 20 })

            // å®¶åº­åˆ—è¡¨
            Scroll() {
              Column() {
                ForEach(this.homes, (home: Home) => {
                  this.HomeSheetItem(home)
                })
              }
            }
            .constraintSize({ maxHeight: 320 })
            .scrollBar(BarState.Off)

            Row()
              .width('100%')
              .height(0.5)
              .backgroundColor('#EEEEEE')

            // åº•éƒ¨ï¼šå®¶åº­ç®¡ç†ï¼ˆå ä½å…¥å£ï¼‰
            Row() {
              Text('å®¶åº­ç®¡ç†')
                .fontSize(18)
                .fontWeight(FontWeight.Bold)
                .fontColor('#1A1A1A')
                .layoutWeight(1)
              Text('âš™ï¸')
                .fontSize(20)
            }
            .width('100%')
            .padding({ left: 20, right: 20, top: 18, bottom: 22 })
          }
          .width('88%')
          .backgroundColor('#FFFFFF')
          .borderRadius(24)
          .margin({ left: 16 })
          .alignItems(HorizontalAlign.Start)
          Blank()
        }
        .width('100%')
        .margin({ top: 96 })
      }
    }
    .width('100%')
    .height('100%')
  }

  @Builder
  RoomTabItem(label: string, roomId: string, count: number) {
    Column() {
      Text(label)
        .fontSize(this.currentRoom === roomId ? 18 : 16)
        .fontWeight(this.currentRoom === roomId ? FontWeight.Bold : FontWeight.Normal)
        .fontColor(this.currentRoom === roomId ? '#FFFFFF' : '#D0DEEA')
      // é€‰ä¸­ä¸‹åˆ’çº¿
      Row()
        .width(20)
        .height(3)
        .borderRadius(2)
        .backgroundColor(this.currentRoom === roomId ? '#FFFFFF' : Color.Transparent)
        .margin({ top: 4 })
    }
    .margin({ right: 20 })
    .onClick(() => {
      this.currentRoom = roomId;
    })
  }

  @Builder
  SheetRoomItem(label: string, roomId: string, count: number) {
    Row() {
      Text(label)
        .fontSize(17)
        .fontWeight(FontWeight.Bold)
        .fontColor('#1A1A1A')
        .layoutWeight(1)
      Text(String(count))
        .fontSize(15)
        .fontColor('#AAAAAA')
    }
    .width('100%')
    .padding({ left: 22, right: 22, top: 15, bottom: 15 })
    .onClick(() => {
      this.currentRoom = roomId;
      this.showRoomSheet = false;
    })
  }

  @Builder
  HomeSheetItem(home: Home) {
    Row() {
      Text(home.name)
        .fontSize(18)
        .fontWeight(FontWeight.Bold)
        .fontColor(this.homeId === home.homeId ? '#34C759' : '#1A1A1A')
        .layoutWeight(1)
      if (this.homeId === home.homeId) {
        Text('âœ“')
          .fontSize(18)
          .fontWeight(FontWeight.Bold)
          .fontColor('#34C759')
      }
    }
    .width('100%')
    .padding({ left: 20, right: 20, top: 16, bottom: 16 })
    .backgroundColor(this.homeId === home.homeId ? '#E8F8EF' : Color.Transparent)
    .onClick(() => {
      this.switchHome(home);
    })
  }

  // æ·±è‰²è®¾å¤‡å¡ï¼ˆåŸç‰ˆæ ·å¼ï¼šæ·±è‰²åœ†è§’å¡ + å›¾æ ‡å— + åç§° + æˆ¿é—´Â·çŠ¶æ€ï¼‰
  @Builder
  DeviceCard(device: Device) {
    Stack({ alignContent: Alignment.TopStart }) {
      Column() {
        // å›¾æ ‡å—
        Row() {
          Text(this.deviceIcon(device.type))
            .fontSize(30)
        }
        .width(56)
        .height(56)
        .borderRadius(12)
        .backgroundColor('#33FFFFFF')
        .justifyContent(FlexAlign.Center)

        Blank()

        Text(device.name)
          .fontSize(15)
          .fontWeight(FontWeight.Medium)
          .fontColor('#FFFFFF')
          .maxLines(1)
          .textOverflow({ overflow: TextOverflow.Ellipsis })
          .width('100%')
          .textAlign(TextAlign.Start)

        Text(device.online
          ? (this.roomName(device.roomId) === '' ? 'æœªåˆ†é…æˆ¿é—´' : this.roomName(device.roomId))
          : `${this.roomName(device.roomId) === '' ? '' : this.roomName(device.roomId) + ' Â· '}è®¾å¤‡ç¦»çº¿`)
          .fontSize(12)
          .fontColor(device.online ? '#B8CBD9' : '#7F93A5')
          .maxLines(1)
          .margin({ top: 3 })
          .width('100%')
          .textAlign(TextAlign.Start)
      }
      .alignItems(HorizontalAlign.Start)
      .width('100%')
      .height(150)
      .padding(14)

      // å¼€å…³ç±»è®¾å¤‡ï¼šå³ä¸Šè§’ç”µæºæŒ‰é’®ï¼ˆçŸ¢é‡ Path ç»˜åˆ¶æ ‡å‡†ç”µæºç¬¦å·ï¼šå¼§çº¿ç¼ºå£+ç«–çº¿ï¼Œé¿å…å­—ç¬¦æ¸²æŸ“æ­ªæ–œï¼‰
      if (this.isSwitchable(device) && device.online) {
        Row() {
          Blank()
          Row() {
            Image($r('app.media.ic_power'))
              .width(17)
              .height(17)
              .fillColor(this.devicePower(device) ? '#FFD54F' : '#B8CBD9')
          }
          .width(34)
          .height(34)
          .borderRadius(17)
          .backgroundColor(this.devicePower(device) ? '#66FFD54F' : '#26FFFFFF')
          .justifyContent(FlexAlign.Center)
          .alignItems(VerticalAlign.Center)
          .onClick(() => {
            this.toggleDevice(device, !this.devicePower(device));
          })
        }
        .width('100%')
        .padding(10)
      }
    }
    .width('100%')
    .height(150)
    .backgroundColor('#D9222B33')
    .borderRadius(16)
    .onClick(() => {
      router.pushUrl({ url: 'pages/DeviceControl', params: { did: device.did } });
    })
  }

  @Builder
  TabBarItem(label: string, index: number) {
    Column() {
      if (index === 0) {
        Image($r('app.media.ic_home'))
          .width(22)
          .height(22)
          .fillColor(this.currentTab === index ? '#4A90D9' : '#999999')
      } else {
        Image($r('app.media.ic_person'))
          .width(22)
          .height(22)
          .fillColor(this.currentTab === index ? '#4A90D9' : '#999999')
      }
      Text(label)
        .fontSize(11)
        .fontColor(this.currentTab === index ? '#4A90D9' : '#999999')
        .margin({ top: 2 })
    }
    .width('100%')
    .justifyContent(FlexAlign.Center)
  }
}

