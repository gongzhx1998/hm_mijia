      }
      // http è·¯å¾„å¤±è´¥ï¼Œç­‰ WebView è·¯å¾„ï¼ˆtryWebFinishï¼‰ç»§ç»­å°è¯•ï¼Œè¿™é‡Œä¸å¼¹ toast
      Logger.error(TAG, 'http finish failed, waiting web path');
    } catch (e) {
      Logger.error(TAG, `tryHttpFinish error: ${e}`);
      promptAction.showToast({ message: 'ç™»å½•æ€è·å–å¼‚å¸¸ï¼Œè¯·é‡è¯•' });
    } finally {
