const TAG = 'Login';

/**
 * ç™»å½•é¡µï¼šçœŸå®å°ç±³è´¦å·ç™»å½•ï¼ˆmicloud ä¸‰æ­¥æ¡æ‰‹ï¼‰
 * äºŒæ¬¡éªŒè¯åœ¨ App å†…åµŒ WebView å®Œæˆï¼ŒéªŒè¯é€šè¿‡å WebView è‡ªåŠ¨è·³è½¬ sts å›è°ƒï¼Œ
 * æ‹¦æˆªå›è°ƒè‡ªåŠ¨å®Œæˆç™»å½•ï¼Œæ— éœ€æ‰‹åŠ¨æ“ä½œã€‚
