            .fontColor('#999999')
            .margin({ top: 8 })
        }
        .margin({ top: 80 })

        Column() {
          TextInput({ placeholder: 'å°ç±³è´¦å·ï¼ˆæ‰‹æœºå·/é‚®ç®±/å°ç±³IDï¼‰', text: this.account })
            .onChange((v: string) => { this.account = v; })
            .height(48)
            .margin({ bottom: 16 })

          TextInput({ placeholder: 'å¯†ç ', text: this.password })
