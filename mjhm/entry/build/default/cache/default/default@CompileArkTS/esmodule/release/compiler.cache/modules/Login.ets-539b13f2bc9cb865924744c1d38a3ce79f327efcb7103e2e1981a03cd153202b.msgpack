  private webController: webview.WebviewController = new webview.WebviewController();

  async doLogin(): Promise<void> {
    if (this.account === '' || this.password === '') {
      promptAction.showToast({ message: 'è¯·è¾“å…¥è´¦å·å’Œå¯†ç ' });
      return;
    }
    this.loading = true;
    this.verifyUrl = '';
    try {
      const ok = await MiCloud.login(this.account, this.password);
      if (!ok) {
        const url = MiCloud.getNotificationUrl();
        if (url !== '') {
          // æ‰“å¼€å†…åµŒ WebView åšäºŒæ¬¡éªŒè¯ï¼šå…ˆåŒæ­¥ http æ¨¡å—çš„ä¼šè¯ Cookie åˆ° WebView
          this.stsPassed = false;
          this.verifyUrl = url;
          return;
        }
        promptAction.showToast({ message: 'ç™»å½•å¤±è´¥ï¼šè¯·æ£€æŸ¥è´¦å·å’Œå¯†ç ' });
        return;
