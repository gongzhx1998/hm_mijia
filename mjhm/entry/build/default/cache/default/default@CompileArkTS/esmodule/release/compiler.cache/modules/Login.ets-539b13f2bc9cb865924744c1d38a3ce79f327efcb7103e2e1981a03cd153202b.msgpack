                this.tryHttpFinish(url);
                return false;
              }
              // sts ç­¾å‘åœ°å€ï¼šç¬¬ä¸€æ¬¡æ”¾è¡Œè®© WebView å†™å…¥ serviceToken cookieï¼Œéšåå»¶è¿Ÿè¯»å–
              if (this.isStsCallback(url)) {
                if (!this.stsPassed) {
                  this.stsPassed = true;
                  Logger.info(TAG, `sts callback, allow once: ${url}`);
                  this.tryWebFinish();
                  return false;
                }
                this.onVerifyIntercept(url);
                return true;
              }
              // å…¶ä»–éªŒè¯å®Œæˆå›è·³ï¼ˆcallbackLogin ç­‰ï¼‰ï¼šæ‹¦æˆªï¼Œç”± App æ¥ç®¡
              if (this.isVerifyCallback(url)) {
                this.onVerifyIntercept(url);
                return true;
              }
