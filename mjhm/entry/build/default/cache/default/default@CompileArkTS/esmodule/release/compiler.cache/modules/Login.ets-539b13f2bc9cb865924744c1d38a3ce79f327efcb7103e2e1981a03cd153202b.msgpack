            .onChange((v: string) => { this.password = v; })
            .height(48)
            .margin({ bottom: 24 })

          Button(this.loading ? 'ç™»å½•ä¸­â€¦' : 'ç™»å½•å°ç±³è´¦å·')
            .width('100%')
            .height(48)
            .backgroundColor('#FF6700')
            .fontColor('#FFFFFF')
            .enabled(!this.loading)
            .onClick(() => { this.doLogin(); })
        }
        .width('100%')
        .padding({ left: 32, right: 32 })
        .margin({ top: 40 })

        Text('ç™»å½•å³ä»£è¡¨åŒæ„ã€Šç”¨æˆ·åè®®ã€‹ä¸ã€Šéšç§æ”¿ç­–ã€‹')
          .fontSize(12)
          .fontColor('#BBBBBB')
          .textAlign(TextAlign.Center)
          .margin({ top: 24 })
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#FFFFFF')
  }
}
