/** è·å–çœŸå®å®¶åº­åˆ—è¡¨ */
export async function getHomes() {
    const cloudHomes = await MiCloud.getHomeList('cn');
    const homes = [];
    for (let i = 0; i < cloudHomes.length; i++) {
        let count = 0;
        for (let j = 0; j < cloudHomes[i].rooms.length; j++) {
            count += cloudHomes[i].rooms[j].dids.length;
        }
        const h = {
            homeId: cloudHomes[i].id,
            name: cloudHomes[i].name,
            roomCount: cloudHomes[i].rooms.length,
            deviceCount: count
        };
        homes.push(h);
    }
    return homes;
}
/** è·å–æŒ‡å®šå®¶åº­ä¸‹çš„çœŸå®æˆ¿é—´åˆ—è¡¨ */
export async function getRooms(homeId) {
    const cloudHomes = await MiCloud.getHomeList('cn');
    const rooms = [];
    for (let i = 0; i < cloudHomes.length; i++) {
        if (cloudHomes[i].id === homeId) {
            for (let j = 0; j < cloudHomes[i].rooms.length; j++) {
                const r = cloudHomes[i].rooms[j];
                const room = {
                    roomId: r.id,
                    name: r.name,
                    homeId: homeId,
                    deviceCount: r.dids.length
                };
                rooms.push(room);
            }
            break;
        }
    }
    return rooms;
}
async function buildHomeRoomMaps() {
    const homeOf = {};
    const roomOf = {};
    const cloudHomes = await MiCloud.getHomeList('cn');
    for (let i = 0; i < cloudHomes.length; i++) {
        const rooms = cloudHomes[i].rooms;
        for (let j = 0; j < rooms.length; j++) {
            const dids = rooms[j].dids;
            for (let k = 0; k < dids.length; k++) {
                homeOf[dids[k]] = cloudHomes[i].id;
                roomOf[dids[k]] = rooms[j].id;
            }
        }
    }
    const maps = { homeOf: homeOf, roomOf: roomOf };
    return maps;
}
/** è·å–çœŸå®è®¾å¤‡åˆ—è¡¨ï¼ˆæŒ‰å®¶åº­ + å¯é€‰æˆ¿é—´è¿‡æ»¤ï¼›homeId ä¸ºç©ºè¡¨ç¤ºä¸è¿‡æ»¤ï¼Œè¿”å›å…¨é‡ï¼‰ */
export async function getDevices(homeId, roomId) {
    let cached = await Storage.getObject(AppConfig.KEY_CLOUD_DEVICES);
    if (cached === null || cached.length === 0) {
        // ç¼“å­˜ä¸ºç©ºæ—¶ç›´æ¥ä»ç±³å®¶äº‘å®æ—¶æ‹‰å–ï¼ˆç™»å½•æ€å·²åœ¨ MiCloud æ¨¡å—å†…å­˜ä¸­ï¼‰
        const fresh = await MiCloud.getDevices('cn');
        await Storage.saveObject(AppConfig.KEY_CLOUD_DEVICES, fresh);
        cached = fresh;
    }
    const maps = await buildHomeRoomMaps();
    const devices = [];
    for (let i = 0; i < cached.length; i++) {
        const cd = cached[i];
        const hid = maps.homeOf[cd.did] ?? '';
        const rid = maps.roomOf[cd.did] ?? '';
        // æŒ‰å®¶åº­è¿‡æ»¤ï¼ˆhomeId éç©ºæ—¶ï¼‰
        if (homeId !== '' && hid !== homeId) {
            continue;
        }
        if (roomId !== undefined && rid !== roomId) {
            continue;
        }
        devices.push(cloudToDevice(cd, rid));
    }
    return devices;
}
/** åˆ‡æ¢å®¶åº­åå¼ºåˆ¶é‡æ–°æ‹‰å–è®¾å¤‡å¹¶åˆ·æ–°ç¼“å­˜ï¼ˆé¿å…ç¼“å­˜é‡Œåªæœ‰æ—§å®¶åº­è®¾å¤‡ï¼‰ */
export async function reloadDevicesForHome(homeId) {
    const fresh = await MiCloud.getDevices('cn');
    await Storage.saveObject(AppConfig.KEY_CLOUD_DEVICES, fresh);
    return getDevices(homeId);
}
/** æ˜¯å¦ä¸ºå¯å¼€å…³ç”µæºçš„è®¾å¤‡ç±»å‹ */
function isSwitchableType(type) {
    return type === 'switch' || type === 'light' || type === 'air_conditioner'
        || type === 'air_purifier' || type === 'humidifier' || type === 'fan'
        || type === 'heater' || type === 'desk';
}
/** æ‰¹é‡è¯»å–å¯å¼€å…³è®¾å¤‡çš„ç”µæºçŠ¶æ€ï¼ˆäº‘ miot-specï¼‰ï¼Œå¡«å……åˆ° device.props['power'] */
export async function readPowerStates(devices) {
    const dids = [];
    for (let i = 0; i < devices.length; i++) {
        if (isSwitchableType(devices[i].type)) {
            dids.push(devices[i].did);
        }
    }
    if (dids.length === 0) {
        return;
    }
    try {
        const states = await MiCloud.miotGetPowerStates(dids);
        for (let i = 0; i < devices.length; i++) {
            const v = states[devices[i].did];
            if (v !== undefined) {
                devices[i].props['power'] = v;
            }
        }
        Logger.info(TAG, `readPowerStates done: ${dids.length} å°è®¾å¤‡ç”µæºçŠ¶æ€å·²è¯»å–`);
    }
    catch (e) {
        Logger.error(TAG, `readPowerStates failed: ${e}`);
    }
}
/**
 * æ§åˆ¶è®¾å¤‡ï¼ˆå…¨éƒ¨äº‘ç«¯ï¼Œä¸èµ°å±€åŸŸç½‘ miIOï¼‰ï¼š
 * - set_power â†’ miot-spec /miotspec/prop/setï¼ˆç”µæºé€šç”¨ siid=2, piid=1, value=booleanï¼‰
 * - å…¶ä»–æ–¹æ³• â†’ æ—§ rpc /home/rpc/{did}
 * æ³¨ï¼šå±€åŸŸç½‘ miIO éœ€è¦æµ‹è¯•æœºä¸è®¾å¤‡åŒç½‘æ®µï¼ˆè®¾å¤‡ localip å¯èƒ½æ˜¯å…¬ç½‘/ç¦»çº¿ IPï¼Œä¸å¯è¾¾ï¼‰ï¼Œ
 *     ç»Ÿä¸€èµ°äº‘ç«¯ miot-spec æœ€å¯é ï¼ˆå®æµ‹å°ç¯/å‡€åŒ–å™¨/æ´—è¡£æœº prop/set å‡æˆåŠŸï¼‰ã€‚
 */
export async function controlDevice(cmd) {
    if (cmd.method === 'set_power') {
        await setPowerCloud(cmd.did, parsePowerOn(cmd.params));
        return true;
    }
    // å…¶ä»–æ–¹æ³•èµ°æ—§ rpcï¼ˆäº®åº¦/æ¸©åº¦ç­‰å…·ä½“ siid/piid å¾…æŒ‰å‹å·è¡¥é½åæ”¹èµ° miot-specï¼‰
    const resp = await MiCloud.rpcRemote(cmd.did, cmd.method, cmd.params);
    checkCloudResult(cmd.did, resp);
    return true;
}
/** è§£æç”µæºå¼€å…³å‚æ•°ï¼ˆå…¼å®¹ 'on'/'off'ã€true/falseã€1/0ï¼‰ */
function parsePowerOn(params) {
    if (params.length === 0) {
        return false;
    }
    const p = params[0];
    if (typeof p === 'boolean') {
        return p;
    }
    if (typeof p === 'number') {
        return p !== 0;
    }
    return p === 'on' || p === 'true' || p === '1';
}
/** äº‘ç«¯å¼€/å…³ç”µæºï¼šmiot-spec /miotspec/prop/setï¼Œsiid=2 piid=1 value=boolean */
async function setPowerCloud(did, on) {
    const resp = await MiCloud.miotSetProp(did, 2, 1, on);
    const code = Number(resp['code'] ?? -1);
    if (code !== 0) {
        throw new Error(`äº‘ç«¯æ§åˆ¶è¿”å›é”™è¯¯ç : ${code}`);
    }
    // æ£€æŸ¥æ¯ä¸ªå±æ€§çš„æ‰§è¡Œç»“æœï¼šresult[].code < 0 è¡¨ç¤ºå¤±è´¥ï¼ˆ0=æ— å˜åŒ–ï¼Œ1=æˆåŠŸï¼‰
    const result = resp['result'];
    if (result instanceof Array) {
        const arr = result;
        for (let i = 0; i < arr.length; i++) {
            const rc = Number(arr[i]['code'] ?? 0);
            if (rc < 0) {
                throw new Error(`è®¾å¤‡å±æ€§è®¾ç½®å¤±è´¥ code=${rc}ï¼ˆå¯èƒ½ç¦»çº¿æˆ–è¯¥å±æ€§ä¸æ”¯æŒï¼‰`);
            }
        }
    }
    Logger.info(TAG, `cloud miot-spec power ok: ${did} -> ${on ? 'on' : 'off'}`);
}
/** æ£€æŸ¥äº‘ç«¯æ§åˆ¶å“åº”ï¼ˆæ—§ rpc æ ¼å¼ï¼šé¡¶å±‚ code + error å­—æ®µï¼‰ */
function checkCloudResult(did, resp) {
    const code = Number(resp['code'] ?? -1);
    if (code !== 0) {
        throw new Error(`äº‘ç«¯æ§åˆ¶è¿”å›é”™è¯¯ç : ${code}`);
    }
    const err = resp['error'];
    if (err !== undefined && err !== null) {
        const errCode = Number(err['code'] ?? 0);
        const errMsg = String(err['message'] ?? '');
        if (errCode !== 0) {
            throw new Error(`è®¾å¤‡æœªå“åº”ï¼ˆäº‘ç«¯ error ${errCode}: ${errMsg}ï¼‰`);
        }
    }
    Logger.info(TAG, `cloud rpc ok: ${did}`);
}
/** ç™»å½•å°ç±³è´¦å·å¹¶åŒæ­¥è´¦å·ä¸‹çš„çœŸå®è®¾å¤‡ï¼ˆå«å±€åŸŸç½‘ token/ipï¼‰ */
export async function syncCloudDevices(username, password) {
    const ok = await MiCloud.login(username, password);
    if (!ok) {
        throw new Error('ç±³å®¶äº‘ç™»å½•å¤±è´¥ï¼ˆè´¦å·/å¯†ç é”™è¯¯ï¼Œæˆ–éœ€å…ˆå®ŒæˆäºŒæ¬¡éªŒè¯ï¼‰');
    }
    const cloudDevices = await MiCloud.getDevices('cn');
    await Storage.saveObject(AppConfig.KEY_CLOUD_DEVICES, cloudDevices);
    Logger.info(TAG, `synced ${cloudDevices.length} cloud devices`);
    const devices = [];
    const maps = await buildHomeRoomMaps();
    for (let i = 0; i < cloudDevices.length; i++) {
        devices.push(cloudToDevice(cloudDevices[i], maps.roomOf[cloudDevices[i].did] ?? ''));
    }
    return devices;
}
/** åœºæ™¯ï¼šæœ¬åœ°çœŸå®å­˜å‚¨ï¼ˆæ‰‹åŠ¨æ‰§è¡Œæ—¶çœŸå®æ§åˆ¶è®¾å¤‡ï¼‰ */
export async function getScenes(homeId) {
    const scenes = await Storage.getObject(AppConfig.KEY_SCENES);
    if (scenes === null) {
        return [];
    }
    return scenes;
}
export async function saveScene(scene) {
    const scenes = await getScenes('');
    let found = false;
    for (let i = 0; i < scenes.length; i++) {
        if (scenes[i].sceneId === scene.sceneId) {
            scenes[i] = scene;
            found = true;
            break;
        }
    }
    if (!found) {
        scenes.push(scene);
    }
    await Storage.saveObject(AppConfig.KEY_SCENES, scenes);
    return true;
}
export async function deleteScene(sceneId) {
    const scenes = await getScenes('');
    const kept = [];
    for (let i = 0; i < scenes.length; i++) {
        if (scenes[i].sceneId !== sceneId) {
            kept.push(scenes[i]);
        }
    }
    await Storage.saveObject(AppConfig.KEY_SCENES, kept);
    return true;
}
/** æ‰‹åŠ¨æ‰§è¡Œåœºæ™¯ï¼šé€ä¸ªåŠ¨ä½œé€šè¿‡ miIO çœŸå®ä¸‹å‘ï¼Œè¿”å›æˆåŠŸæ¡æ•° */
export async function runScene(sceneId) {
    const scenes = await getScenes('');
    let target = null;
    for (let i = 0; i < scenes.length; i++) {
        if (scenes[i].sceneId === sceneId) {
            target = scenes[i];
            break;
        }
    }
    if (target === null) {
        throw new Error('åœºæ™¯ä¸å­˜åœ¨');
    }
    let okCount = 0;
    for (let i = 0; i < target.actions.length; i++) {
        const a = target.actions[i];
        const cmd = { did: a.did, method: a.method, params: a.params };
        try {
            await controlDevice(cmd);
            okCount++;
        }
        catch (e) {
            Logger.error(TAG, `scene action failed: ${a.did}`);
        }
    }
    return okCount;
}
/** äº‘ç«¯è®¾å¤‡ â†’ App è®¾å¤‡æ¨¡å‹ï¼ˆå¸¦ token/ipï¼Œä¾› miIO å±€åŸŸç½‘ç›´æ§ï¼‰ */
function cloudToDevice(cd, roomId) {
    const dev = {
        did: cd.did,
        model: cd.model,
        name: cd.name,
        type: deviceTypeFromModel(cd.model, cd.specType ?? ''),
        roomId: roomId,
        online: cd.isOnline,
        icon: 'icon_device',
        token: cd.token,
        ip: cd.localip,
        props: {}
    };
    return dev;
}
/** ä» miot spec_type æå–ç±»åˆ«ï¼ˆurn:miot-spec-v2:device:<ç±»åˆ«>:<uuid>:<model>:<version>ï¼‰ */
function specCategory(specType) {
    const marker = 'device:';
    const idx = specType.indexOf(marker);
    if (idx < 0) {
        return '';
    }
    const rest = specType.substring(idx + marker.length);
    const colon = rest.indexOf(':');
    return colon < 0 ? rest.toLowerCase() : rest.substring(0, colon).toLowerCase();
}
/** ä» model æå–ç±»åˆ«ï¼ˆvendor.category.modelï¼Œå¦‚ xiaomi.airp.mp4 â†’ airpï¼‰ */
function modelCategory(model) {
    const dot = model.indexOf('.');
    if (dot < 0) {
        return model.toLowerCase();
    }
    const rest = model.substring(dot + 1);
    const dot2 = rest.indexOf('.');
    return dot2 < 0 ? rest.toLowerCase() : rest.substring(0, dot2).toLowerCase();
}
/**
 * è®¾å¤‡ç±»å‹è¯†åˆ«ï¼šä¼˜å…ˆ miot spec_type ç±»åˆ«ï¼Œå›é€€ model ç±»åˆ«ã€‚
 * spec ç±»åˆ«æ˜¯æƒå¨ï¼ˆå¸¦è¿å­—ç¬¦ï¼Œå¦‚ air-conditioner / water-purifier / induction-cookerï¼‰ï¼Œ
 * å¿…é¡»ç²¾ç¡®åŒ¹é… + æ­£ç¡®æ’åºï¼Œå¦åˆ™æ¼åˆ¤ï¼ˆè¿å­—ç¬¦å­ä¸²åŒ¹é…ä¼šå¤±è´¥ï¼‰ã€‚
 */
function deviceTypeFromModel(model, specType) {
    const sc = specCategory(specType);
    const mc = modelCategory(model);
    const key = sc !== '' ? sc : mc;
    // ç²¾ç¡®åŒ¹é…ä¼˜å…ˆï¼ˆå¸¦è¿å­—ç¬¦çš„ spec ç±»åˆ«ï¼‰
    if (key === 'air-conditioner' || key.indexOf('air-condition') >= 0 || key.indexOf('aircondition') >= 0) {
        return 'air_conditioner';
    }
    if (key === 'water-purifier' || key.indexOf('water-purif') >= 0 || key.indexOf('waterpur') >= 0) {
        return 'water_purifier';
    }
    if (key === 'air-purifier' || key.indexOf('air-purif') >= 0 || key.indexOf('airpur') >= 0) {
        return 'air_purifier';
    }
    if (key === 'induction-cooker' || key.indexOf('cooker') >= 0 || key.indexOf('ihcooker') >= 0) {
        return 'cooker';
    }
    if (key === 'temperature-humidity-sensor' || key === 'humidity-sensor') {
        return 'sensor';
    }
    if (key === 'juicer' || key.indexOf('juicer') >= 0) {
        return 'juicer';
    }
    if (key === 'speaker' || key.indexOf('speaker') >= 0 || key.indexOf('wifispeaker') >= 0) {
        return 'speaker';
    }
    if (key.indexOf('plug') >= 0 || key.indexOf('switch') >= 0 || key.indexOf('outlet') >= 0
        || key.indexOf('acpartner') >= 0 || key.indexOf('socket') >= 0) {
        return 'switch';
    }
    if (key.indexOf('purifier') >= 0) {
        return 'air_purifier';
    }
    if (key.indexOf('humid') >= 0 || key.indexOf('dehumid') >= 0) {
        return 'humidifier';
    }
    if (key.indexOf('light') >= 0 || key.indexOf('bulb') >= 0 || key.indexOf('lamp') >= 0) {
        return 'light';
    }
    if (key.indexOf('sensor') >= 0) {
        return 'sensor';
    }
    if (key.indexOf('camera') >= 0 || key.indexOf('ipc') >= 0) {
        return 'camera';
    }
    if (key.indexOf('desk') >= 0 || key.indexOf('table') >= 0) {
        return 'desk';
    }
    if (key.indexOf('fan') >= 0) {
        return 'fan';
    }
    if (key.indexOf('heater') >= 0) {
        return 'heater';
    }
    if (key.indexOf('curtain') >= 0) {
        return 'curtain';
    }
    if (key.indexOf('lock') >= 0) {
        return 'lock';
    }
    if (key.indexOf('washer') >= 0 || key.indexOf('washing') >= 0) {
        return 'washer';
    }
    if (key.indexOf('fridge') >= 0) {
        return 'fridge';
    }
    if (key.indexOf('router') >= 0) {
        return 'router';
    }
    return 'device';
}
