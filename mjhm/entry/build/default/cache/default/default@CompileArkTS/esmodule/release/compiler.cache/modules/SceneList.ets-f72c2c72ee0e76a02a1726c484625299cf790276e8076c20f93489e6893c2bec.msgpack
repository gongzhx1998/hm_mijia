@Entry
@Component
struct SceneList {
  @State scenes: Scene[] = [];

  async aboutToAppear(): Promise<void> {
    this.scenes = await ApiService.getScenes('');
  }

  async runScene(scene: Scene): Promise<void> {
    try {
      const okCount = await ApiService.runScene(scene.sceneId);
      promptAction.showToast({ message: `å·²æ‰§è¡Œ ${okCount} ä¸ªåŠ¨ä½œ` });
    } catch (e) {
      promptAction.showToast({ message: 'åœºæ™¯æ‰§è¡Œå¤±è´¥' });
    }
  }

  @Builder
  SceneRow(scene: Scene) {
    Row() {
      Column() {
        Text(scene.name)
          .fontSize(15)
          .fontColor('#1A1A1A')
        Text(this.describeCondition(scene))
          .fontSize(12)
          .fontColor('#999999')
