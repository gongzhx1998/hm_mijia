        .backgroundColor('#E8F3FF')
        .borderRadius(14)
        .margin({ right: 10 })
        .onClick(() => { this.runScene(scene); })

      Toggle({ type: ToggleType.Switch, isOn: scene.enabled })
        .selectedColor('#1677FF')
        .onChange((isOn: boolean) => {
          scene.enabled = isOn;
          ApiService.saveScene(scene);
        })
    }
    .width('100%')
    .padding(14)
    .backgroundColor('#FFFFFF')
    .borderRadius(12)
    .margin({ bottom: 10 })
    .onClick(() => {
      router.pushUrl({ url: 'pages/SceneEdit', params: { sceneId: scene.sceneId } });
    })
  }

  describeCondition(scene: Scene): string {
    if (scene.conditions.length === 0) {
      return 'æ— è§¦å‘æ¡ä»¶';
    }
    const c = scene.conditions[0];
    if (c.type === 'manual') {
      return 'æ‰‹åŠ¨è§¦å‘';
    }
    if (c.type === 'time') {
      return `å®šæ—¶ ${c.time}`;
    }
    return 'ä¼ æ„Ÿå™¨è§¦å‘';
  }

  build() {
    Column() {
      Row() {
        Text('â†')
          .fontSize(20)
          .onClick(() => { router.back(); })
        Text('åœºæ™¯')
          .fontSize(18)
          .fontWeight(FontWeight.Medium)
          .margin({ left: 12 })
        Blank()
        Text('ï¼‹ æ–°å»º')
          .fontSize(14)
          .fontColor('#1677FF')
          .onClick(() => {
            router.pushUrl({ url: 'pages/SceneEdit', params: { sceneId: '' } });
          })
      }
      .width('100%')
      .padding({ left: 16, right: 16, top: 14, bottom: 12 })

      if (this.scenes.length === 0) {
        Column() {
          Text('âš¡')
            .fontSize(48)
          Text('æš‚æ— åœºæ™¯')
            .fontSize(15)
            .fontColor('#999999')
            .margin({ top: 12 })
          Text('ç‚¹å‡»å³ä¸Šè§’ ï¼‹ æ–°å»ºï¼Œè®©è®¾å¤‡è‡ªåŠ¨æ‰§è¡Œ')
            .fontSize(13)
            .fontColor('#BBBBBB')
            .margin({ top: 6 })
        }
        .width('100%')
        .layoutWeight(1)
        .justifyContent(FlexAlign.Center)
      } else {
        Scroll() {
          Column() {
            ForEach(this.scenes, (scene: Scene) => {
              this.SceneRow(scene)
            })
          }
          .padding({ left: 16, right: 16, bottom: 20 })
        }
        .layoutWeight(1)
        .scrollBar(BarState.Off)
      }
    }
    .width('100%')
    .height('100%')
    .backgroundColor('#F5F6F7')
  }
